# Copy to server/.env for local development. Never commit the real file.

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000","https://vyomaibytattvaco.vercel.app"]

# Database (Supabase Postgres). Either set DATABASE_URL, or the DB_* parts.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DB_HOST=your-supabase-host.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your-password

# Auth: Supabase project URL (ES256/RS256 tokens) and/or JWT secret (HS256 tokens)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_SECRET=

# AI provider for /api/ai: "groq" (default) or "huggingface". Keys stay on the server only.
LLM_PROVIDER=groq
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# HUGGINGFACE_API_TOKEN=

# Research web search limited to approved government / open reference sites (app/services/source_registry.py).
# Free plan: 1,000 searches a month, no card (app.tavily.com). Without it, Wikipedia search still works.
TAVILY_API_KEY=

# --- Email: signed Terms & Conditions are sent to TERMS_RECIPIENT_EMAIL over SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@example.com
SMTP_PASSWORD=
# Optional; defaults to SMTP_USERNAME
SMTP_FROM=
# starttls (port 587), ssl (port 465) or none (local testing only)
SMTP_SECURITY=starttls
TERMS_RECIPIENT_EMAIL=renee@manuvanzara.com
